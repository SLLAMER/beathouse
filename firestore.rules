rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Вспомогательные функции
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Коллекция пользователей (Users)
    match /users/{userId} {
      allow read: if isAuthenticated();

      // При создании нового аккаунта роль должна быть только 'buyer',
      // и пользователь не может сам себя разблокировать
      allow create: if isAuthenticated() && isOwner(userId) &&
        request.resource.data.role == 'buyer' &&
        request.resource.data.isBlocked == false;

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) &&
          // Обычный пользователь не может менять свою роль на 'admin' или менять статус блокировки
          request.resource.data.role != 'admin' &&
          request.resource.data.isBlocked == resource.data.isBlocked &&
          // Предотвращаем смену роли с seller на admin через прямое обновление
          (resource.data.role != 'seller' || request.resource.data.role == 'seller' || request.resource.data.role == 'buyer')
        )
      );

      allow delete: if isAdmin();
    }

    // Коллекция продюсеров (Producers)
    match /producers/{producerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(producerId) && getUserData().role == 'seller';
      allow update: if isAuthenticated() && (isOwner(producerId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Коллекция битов (Beats)
    match /beats/{beatId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && getUserData().role == 'seller';
      allow update: if isAuthenticated() && (resource.data.producerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.producerId == request.auth.uid || isAdmin());

      // Подколлекция чанков аудио
      match /audio_chunks/{chunkId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() &&
          (get(/databases/$(database)/documents/beats/$(beatId)).data.producerId == request.auth.uid || isAdmin());
      }
    }

    // Коллекция заказов (Orders)
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.producerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.producerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Коллекция уведомлений (Notifications)
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Коллекция подписок (Follows)
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.followerId == request.auth.uid || isAdmin());
    }

    // Коллекция чатов (Chats)
    match /chats/{chatId} {
      // Доступ только если ID чата содержит UID пользователя (формат uid1_uid2)
      allow read, write: if isAuthenticated() && (chatId.contains(request.auth.uid) || isAdmin());

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (chatId.contains(request.auth.uid) || isAdmin());
        allow create: if isAuthenticated() && (request.resource.data.senderId == request.auth.uid || isAdmin());
        allow update: if isAuthenticated() && (resource.data.receiverId == request.auth.uid || isAdmin()); // для отметки о прочтении
        allow delete: if isAdmin();
      }
    }

    // Коллекция отзывов (Reviews)
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
