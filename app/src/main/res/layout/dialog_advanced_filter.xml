<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/advanced_filter"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        android:layout_marginBottom="24dp" />

    <!-- Sorting Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sorting"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:textAllCaps="true"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface_container"
        app:strokeColor="@color/outline_variant"
        app:strokeWidth="0.5dp">

        <RadioGroup
            android:id="@+id/rg_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/rb_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/default_sort"
                android:textColor="@color/on_surface"
                android:buttonTint="@color/primary"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rb_price_asc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/price_lowest_first"
                android:textColor="@color/on_surface"
                android:buttonTint="@color/primary"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rb_price_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/price_highest_first"
                android:textColor="@color/on_surface"
                android:buttonTint="@color/primary"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rb_bpm_asc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bpm_slowest_first"
                android:textColor="@color/on_surface"
                android:buttonTint="@color/primary"
                android:padding="8dp" />

            <RadioButton
                android:id="@+id/rb_bpm_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bpm_fastest_first"
                android:textColor="@color/on_surface"
                android:buttonTint="@color/primary"
                android:padding="8dp" />

        </RadioGroup>
    </com.google.android.material.card.MaterialCardView>

    <!-- BPM Range Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bpm_range"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:textAllCaps="true"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/outline_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_bpm_min"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/min_bpm"
                android:inputType="number"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/on_surface_variant"
            android:layout_marginHorizontal="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/outline_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_bpm_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/max_bpm"
                android:inputType="number"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Tag Search Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tag_search"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:textAllCaps="true"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/outline_variant"
        app:startIconDrawable="@drawable/ic_filter"
        app:startIconTint="@color/on_surface_variant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_tag_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tag_hint"
            android:inputType="text"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/clear"
            android:textColor="@color/on_surface"
            app:strokeColor="@color/outline_variant"
            app:cornerRadius="12dp"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/apply"
            android:textColor="@color/on_primary"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/cancel_btn"
        android:textColor="@color/error" />

</LinearLayout>
