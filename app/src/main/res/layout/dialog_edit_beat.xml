<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_container"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Заголовок с иконкой -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_edit"
                android:tint="@color/primary"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Beat"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

        </LinearLayout>

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline"
            android:layout_marginBottom="16dp" />

        <!-- Текущая обложка -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Cover"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface_variant"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/ivCurrentCover"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note"
                android:background="@drawable/cover_background"
                android:padding="4dp" />

        </FrameLayout>

        <!-- Поле Title -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="@color/surface"
            app:boxStrokeColor="@color/outline"
            app:hintTextColor="@color/on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Beat Title"
                android:textColor="@color/on_surface"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Genre & Key & BPM Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Genre -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/genreLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxBackgroundColor="@color/surface"
                app:boxStrokeColor="@color/outline"
                app:endIconMode="dropdown_menu"
                app:endIconTint="@color/on_surface_variant">

                <AutoCompleteTextView
                    android:id="@+id/etEditGenre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Genre"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Key -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/keyLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxBackgroundColor="@color/surface"
                app:boxStrokeColor="@color/outline"
                app:endIconMode="dropdown_menu"
                app:endIconTint="@color/on_surface_variant">

                <AutoCompleteTextView
                    android:id="@+id/etEditKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Key"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- BPM -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxBackgroundColor="@color/surface"
                app:boxStrokeColor="@color/outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditBpm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="BPM"
                    android:inputType="number"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- ✅ PRICE SECTION (для обратной совместимости, может быть скрыт) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/priceLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="@color/surface"
            app:boxStrokeColor="@color/outline"
            app:prefixText="$"
            app:prefixTextColor="@color/on_surface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Price"
                android:inputType="number"
                android:textColor="@color/on_surface"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ✅ LICENSE PRICES SECTION (три цены для разных лицензий) -->
        <LinearLayout
            android:id="@+id/licensePricesLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:background="@drawable/rounded_rectangle_outline"
            android:backgroundTint="@color/surface_variant"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="License Prices"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="12dp" />

            <!-- MP3 + WAV -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxBackgroundColor="@color/surface"
                app:boxStrokeColor="@color/outline"
                app:prefixText="$"
                app:prefixTextColor="@color/on_surface">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditPriceMp3Wav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="MP3 + WAV Price"
                    android:inputType="numberDecimal"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Track Out (Stems) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxBackgroundColor="@color/surface"
                app:boxStrokeColor="@color/outline"
                app:prefixText="$"
                app:prefixTextColor="@color/on_surface">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditPriceTrackOut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Track Out (Stems) Price"
                    android:inputType="numberDecimal"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Exclusive Rights -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxBackgroundColor="@color/surface"
                app:boxStrokeColor="@color/outline"
                app:prefixText="$"
                app:prefixTextColor="@color/on_surface">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditPriceExclusive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Exclusive Rights Price"
                    android:inputType="numberDecimal"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Free Beat Switch -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Free Beat"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchEditFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/Theme.Material3.Dark" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="@color/surface"
            app:boxStrokeColor="@color/outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Description"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Update Cover Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateCover"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:text="Update Cover Image"
            app:icon="@drawable/ic_add_photo"
            app:iconGravity="textStart"
            app:cornerRadius="12dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:indeterminateTint="@color/primary" />

        <!-- Кнопка Save -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBeat"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Changes"
            app:icon="@drawable/ic_save"
            app:iconGravity="textStart"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>