<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:title="@string/checkout"
            app:titleTextColor="@color/on_surface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/on_surface" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Заказ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_container"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/order_summary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="12dp" />

                    <!-- Список товаров -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_order_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/outline_variant"
                        android:layout_marginVertical="12dp" />

                    <!-- Количество товаров -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_items"
                            android:textColor="@color/on_surface_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_total_items"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Итоговая сумма -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_to_pay"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_order_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0"
                            android:textColor="@color/primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Способ оплаты -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_container"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_method"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Карта -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            style="@style/Widget.BeatHouse.Card"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/outline_variant"
                            app:strokeWidth="0.5dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:stateListAnimator="@null">

                            <RadioButton
                                android:id="@+id/rb_card"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/primary"
                                android:padding="12dp"
                                android:clickable="false"
                                android:text="@string/credit_card"
                                android:textColor="@color/on_surface"
                                android:textSize="15sp" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- СБП -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_sbp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            style="@style/Widget.BeatHouse.Card"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/outline_variant"
                            app:strokeWidth="0.5dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:stateListAnimator="@null">

                            <RadioButton
                                android:id="@+id/rb_sbp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/primary"
                                android:padding="12dp"
                                android:clickable="false"
                                android:text="@string/sbp"
                                android:textColor="@color/on_surface"
                                android:textSize="15sp" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- QR код -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_qr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.BeatHouse.Card"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/outline_variant"
                            app:strokeWidth="0.5dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:stateListAnimator="@null">

                            <RadioButton
                                android:id="@+id/rb_qr"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/primary"
                                android:padding="12dp"
                                android:clickable="false"
                                android:text="@string/qr_code_payment"
                                android:textColor="@color/on_surface"
                                android:textSize="15sp" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Кнопка оплаты -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_complete_payment"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="@string/continue_to_payment"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_primary_gradient"
        app:backgroundTint="@null"
        app:cornerRadius="24dp"
        android:textColor="@color/on_primary" />

</LinearLayout>